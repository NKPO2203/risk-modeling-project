    "initial_value = 1000\n",
    "final_value = 900\n",
    "\n",
    "loss = initial_value - final_value\n",
    "loss_percentage = (loss / initial_value) * 100\n",
    "\n",
    "print(\"Perte :\", loss)\n",
    "print(\"Perte en % :\", loss_percentage)"
